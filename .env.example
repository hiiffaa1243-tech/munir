# Copy to .env.local for local development. On Vercel, set these in Project Settings -> Environment Variables.
# Never commit real values.

OPENAI_API_KEY=            # generation, query understanding, translation, embeddings, speech
GOOGLE_API_KEY=            # independent verifier (a different provider than the generator)
SUPABASE_URL=              # https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY= # server-only secret key (sb_secret_... or the legacy service_role key)
APP_SECRET=                # long random string; signs claim tokens and the specialist session
SPECIALIST_PASSCODE=       # passcode for /specialist

# Optional overrides (defaults shown). A role may list fallback models separated by commas.
# FAST_PROVIDER=openai       FAST_MODEL=gpt-4.1-mini
# GEN_PROVIDER=openai        GEN_MODEL=gpt-4.1
# VERIFY_PROVIDER=google     VERIFY_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash
# BASELINE_PROVIDER=openai   BASELINE_MODEL=gpt-4.1
# VERIFY_FALLBACK=off        # fail closed instead of using a second model when the verifier is unreachable
# EMBED_MODEL=text-embedding-3-small  STT_MODEL=gpt-4o-transcribe  STT_PARTIAL_MODEL=gpt-4o-mini-transcribe  TTS_MODEL=gpt-4o-mini-tts  TTS_VOICE=alloy  CHAT_SEED=7
# VA_SIM_MIN=0.55  RETRIEVE_SIM_MIN=0.28  RETRIEVE_TOP_K=6
# NEXT_PUBLIC_APP_URL=https://your-domain   # used in QR links; defaults to the request host

# Local smoke test without any network or keys:
# MUNIR_MOCK=1
